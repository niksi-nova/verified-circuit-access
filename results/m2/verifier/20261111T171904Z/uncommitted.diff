+            node = float(
+                a["node_type"] != b["node_type"] or a["category"] != b["category"]
+            )
+            common = sum((lab1[i] & lab2[j]).values())
+            cost[i, j] = node + 0.5 * (max(deg_a, deg_b) - common)
